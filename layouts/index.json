{{- $refUnix := (time "2026-10-25T10:35:00+08:00").Unix -}}
{{- $items := slice -}}
{{- range sort (where .Site.RegularPages "Section" "!=" "") "Lastmod" "desc" -}}
  {{- $ageDays := div (sub $refUnix .Lastmod.Unix) 86400 -}}
  {{- $isStale := gt $ageDays 180 -}}
  {{- $item := dict
      "title" .Title
      "section" .Section
      "permalink" .Permalink
      "rel_permalink" .RelPermalink
      "lastmod" (.Lastmod.Format "2006-01-02")
      "age_days" $ageDays
      "stale_over_6m" $isStale
      "tags" (.Params.tags | default slice)
      "summary" (.Params.summary | default "")
      "ext_url" (.Params.ext_url | default "")
      "backup_url" (.Params.backup_url | default "")
      "repo_file" (printf "content/%s" .File.Path)
  -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- dict
    "site" .Site.Title
    "base_url" .Site.BaseURL
    "generated_at" "2026-10-25T10:35:00+08:00"
    "policy" "Content and verified links only. No market commentary. No asset/position disclosure."
    "stale_threshold_days" 180
    "broken_and_stale_report_url" ("404.txt" | absURL)
    "count" (len $items)
    "items" $items
| jsonify (dict "indent" "  ") -}}
