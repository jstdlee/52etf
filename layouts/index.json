{{- $refUnix := (time "2026-10-24T21:30:00+08:00").Unix -}}
{{- $allPages := sort (where .Site.RegularPages "Section" "!=" "") "Lastmod" "desc" -}}
{{- $items := slice -}}
{{- range $allPages -}}
  {{- $ageDays := div (sub $refUnix .Lastmod.Unix) 86400 -}}
  {{- $isStale := gt $ageDays 180 -}}
  {{- $items = $items | append (dict
      "title" .Title
      "section" .Section
      "rel_permalink" .RelPermalink
      "permalink" .Permalink
      "repo_path" (printf "content/%s" .File.Path)
      "updated_at" (.Lastmod.Format "2006-01-02 15:04")
      "age_days" $ageDays
      "is_stale_6m" $isStale
      "keywords" (.Params.keywords | default slice)
      "summary" (.Params.summary | default "")
      "ext_url" (.Params.ext_url | default "")
      "backup_url" (.Params.backup_url | default "")
      "raw_content" (.Plain | chomp)
  ) -}}
{{- end -}}
{{- dict
  "site" .Site.Title
  "generated_at" "2026-10-24T21:30:00+08:00"
  "policy" "PURE_DATA_AND_LINKS_ONLY_NO_INTERPRETATION_NO_ASSET_DISCLOSURE"
  "stale_days_limit" 180
  "total_entries" (len $items)
  "entries" $items
| jsonify (dict "indent" "  ") -}}
